# Copy to .env. These are placeholders/local-development defaults only.
APP_MODE=live
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DATABASE_URL=postgresql+psycopg://langchain:langchain@localhost:6024/langchain
SEED_KNOWLEDGE_BASE=true

# Values consumed by docker-compose.yml for the local-only database.
POSTGRES_DB=langchain
POSTGRES_USER=langchain
POSTGRES_PASSWORD=langchain
POSTGRES_PORT=6024
